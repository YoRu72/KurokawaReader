{
  "name": "kurokawa-reader",
  "version": "0.53.1",
  "description": "KurokawaReader — an offline reader for EPUB, PDF, DOCX, XLSX, PPTX, TXT and more, with first-class Arabic typography (Lora · Uthman TN1 · Sultan).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/build.mjs --serve",
    "test": "node tests/smoke.cjs en && node tests/smoke.cjs ar",
    "fixtures": "python3 scripts/make-fixtures.py",
    "android:prepare": "npx cap add android && node native/android/overlay.mjs && npx cap sync android",
    "ios:prepare": "npx cap add ios && node native/ios/overlay.mjs && npx cap sync ios"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "jszip": "^3.10.1",
    "pako": "^1.0.11",
    "marked": ">=15.0.0",
    "pdfjs-dist": "6.2.108",
    "@capacitor/core": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "capacitor-plugin-kurokawa": "file:native/capacitor-plugin-kurokawa",
    "docx": "^9.5.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": ">=0.25.0",
    "typescript": ">=5.6.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  },
  "license": "MIT"
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurokawa Tools",
  "version": "../../package.json",
  "identifier": "app.kurokawa.tools",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurokawa Tools",
  "version": "../../package.json",
  "identifier": "app.kurokawa.tools",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kurokawa",
    "category": "Utility",
    "shortDescription": "Downloads, torrents, streaming and the tools around them",
    "fileAssociations": [
      { "ext": ["torrent"], "name": "Torrent", "role": "Viewer", "mimeType": "application/x-bittorrent" }
    ],
    "resources": {
      "../aria2/": "aria2/",
      "../7zip/": "7zip/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Arabic", "Japanese", "Korean", "SimpChinese"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "./installer/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet", "kurokawatools"]
      }
    }
  }
}

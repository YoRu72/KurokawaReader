{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KurokawaReader",
  "version": "../../package.json",
  "identifier": "app.kurokawa.reader",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kurokawa",
    "category": "Productivity",
    "shortDescription": "An offline reader for EPUB, PDF, DOCX, XLSX, PPTX, TXT and more",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

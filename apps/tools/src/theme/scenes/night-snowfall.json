{
  "format": "ktscene/1",
  "meta": { "id": "night-snowfall", "name": "Night snowfall" },
  "view": { "fps": 24, "resolution": 0.5 },
  "space": { "w": 1600, "h": 1000, "overscan": 0.06, "fit": "cover" },
  "palette": [
    { "id": "sky0", "dark": "#040822", "light": "#b4c5e6" },
    { "id": "sky1", "dark": "#0e1e5c", "light": "#c3d1ec" },
    { "id": "sky2", "dark": "#26357f", "light": "#d3ddf1" },
    { "id": "sky3", "dark": "#6a3c80", "light": "#dcd2ea" },
    { "id": "glow", "dark": "#e07aa6", "light": "#f4c8dd" },
    { "id": "moon", "dark": "#eef3ff", "light": "#ffffff" },
    { "id": "far", "dark": "#1f3078", "light": "#b4c3e3" },
    { "id": "mid", "dark": "#10195a", "light": "#8aa0cc" },
    { "id": "near", "dark": "#050a26", "light": "#5a74a8" },
    { "id": "fog", "dark": "#8078d6", "light": "#ffffff" },
